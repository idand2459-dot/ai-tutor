# Copy to .env and fill in. Never commit .env.

# Required. Anthropic API key, used only by this proxy.
ANTHROPIC_API_KEY=

# Required. The only origin allowed by CORS.
FRONTEND_URL=http://localhost:3000

# Optional. Port on 127.0.0.1. Defaults to 4000.
PORT=4000

# Optional. Defaults to claude-haiku-4-5.
ANTHROPIC_MODEL=
